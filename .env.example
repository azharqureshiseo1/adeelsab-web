# GA4 measurement ID. Leave empty to disable analytics entirely.
NEXT_PUBLIC_GA_ID=
# Absolute origin of the deployed site, used for metadataBase / sitemap.
NEXT_PUBLIC_SITE_URL=https://www.adeelsab.com
# Path the waitlist form posts to (PHP endpoint shipped alongside the static build).
NEXT_PUBLIC_FORM_ENDPOINT=/api/submit.php
