# Copy to .env.local for local development. Never commit .env.local.
# On a host, set these in the panel's environment variables instead.

# --- Site ---------------------------------------------------------------------
# Canonical origin. Drives metadataBase, canonical URLs, the sitemap and OG tags.
NEXT_PUBLIC_SITE_URL=https://www.adeelsab.com

# GA4 measurement ID. Leave empty and NO analytics code is loaded at all.
NEXT_PUBLIC_GA_ID=

# --- Waitlist leads -----------------------------------------------------------
# Where waitlist submissions go. Set at least one channel, or the form returns an
# error and falls back to WhatsApp — deliberately, so a lead is never silently
# dropped. Check it with: npm run test:leads
#
# Email, via Resend (https://resend.com — free tier is plenty):
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=

# Optional. Defaults to Resend's sandbox sender, which works without verifying a
# domain. To send from your own domain, verify it in Resend first.
# LEAD_FROM_EMAIL=AdeelSab <leads@adeelsab.com>

# Or POST each lead as JSON to your own endpoint (Google Apps Script, Zapier,
# your CRM). Can be used instead of, or alongside, email.
# LEAD_WEBHOOK_URL=

# --- Advanced -----------------------------------------------------------------
# Normally left unset: the build target decides this. Static builds post to the
# PHP endpoint, server builds to the route handler.
# NEXT_PUBLIC_FORM_ENDPOINT=
